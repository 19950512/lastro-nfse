# Modelo de configuração. Gere o .env real com `pnpm infra:env` (senhas aleatórias).
# Em produção estes valores vêm do gerenciador de segredos (SEGURANCA.md, Fase 1).

LASTRO_ARQUIVO=postgres

LASTRO_PG_HOST=127.0.0.1
LASTRO_PG_PORTA=55432
LASTRO_PG_BANCO=lastro
# exigir | desligado — use "exigir" fora do ambiente local
LASTRO_PG_SSL=desligado
LASTRO_PG_ADMIN_SENHA=
LASTRO_PG_COLETOR_SENHA=
LASTRO_PG_LEITOR_SENHA=

LASTRO_S3_ENDPOINT=http://127.0.0.1:59000
LASTRO_S3_PORTA=59000
LASTRO_S3_REGIAO=us-east-1
LASTRO_S3_BUCKET=lastro-snapshots
LASTRO_S3_ACCESS_KEY=
LASTRO_S3_SECRET_KEY=
LASTRO_S3_RETENCAO_DIAS=3650
