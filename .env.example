# Modelo de configuração. Gere o .env real com `pnpm infra:env` (senhas aleatórias).
# Em produção estes valores vêm do gerenciador de segredos (SEGURANCA.md, Fase 1).

LASTRO_ARQUIVO=postgres

LASTRO_PG_HOST=127.0.0.1
LASTRO_PG_PORTA=55432
LASTRO_PG_BANCO=lastro
# exigir | desligado — use "exigir" fora do ambiente local
LASTRO_PG_SSL=desligado
LASTRO_PG_ADMIN_SENHA=
LASTRO_PG_COLETOR_SENHA=
LASTRO_PG_LEITOR_SENHA=
LASTRO_PG_NOTIFICADOR_SENHA=
LASTRO_PG_PROCESSADOR_SENHA=
LASTRO_PG_API_SENHA=
LASTRO_PG_CURADORIA_SENHA=

LASTRO_S3_ENDPOINT=http://127.0.0.1:59000
LASTRO_S3_PORTA=59000
LASTRO_S3_REGIAO=us-east-1
LASTRO_S3_BUCKET=lastro-snapshots
LASTRO_S3_ACCESS_KEY=
LASTRO_S3_SECRET_KEY=
LASTRO_S3_RETENCAO_DIAS=3650

# Webhooks
# URL pública da API, usada nos links enviados aos assinantes
LASTRO_API_URL_PUBLICA=http://127.0.0.1:8080

# Perguntas (Fase 2). A credencial da Anthropic vem do ambiente (ANTHROPIC_API_KEY ou perfil `ant auth login`);
# sem ela, POST /v1/perguntas responde 503 e o resto da API funciona.
# Modelo das respostas (perguntas e verificações) e da extração de fatos (`pnpm lastro fatos propor`).
# Aceitos: claude-opus-5-5 (padrão), claude-sonnet-5-5, claude-haiku-5-5. Vazio = padrão; FATOS vazio = mesmo de LASTRO_LLM_MODELO.
# O Haiku 5.5 não tem modelo reserva para recusas. Trocar o modelo dos fatos faz o novo modelo passar uma vez por cada documento.
LASTRO_LLM_MODELO=
LASTRO_LLM_MODELO_FATOS=
# Disjuntor global: soma do custo de LLM de todos os clientes por dia (UTC), em dólares
LASTRO_LLM_ORCAMENTO_DIARIO_USD=20
# Dias que uma pergunta e sua resposta ficam guardadas (LGPD); `pnpm lastro expurgar` apaga as vencidas
LASTRO_RETENCAO_CONSULTAS_DIAS=30

# MCP
# stdio: cliente cuja cota e registro valem para perguntar_nfse (vazio = ferramenta desativada)
LASTRO_MCP_CLIENTE_ID=
# HTTP remoto (obrigatórios para `pnpm mcp:http`): URL pública deste servidor (audiência do token), emissor OAuth e JWKS
LASTRO_MCP_URL_RECURSO=
LASTRO_MCP_OAUTH_EMISSOR=
LASTRO_MCP_OAUTH_JWKS=

# Painel de curadoria (Fase 3, `pnpm admin`). Origem separada da API (SEGURANCA.md §4).
# Origem pública do painel (o retorno do SSO é <origem>/oidc/retorno)
LASTRO_ADMIN_URL_PUBLICA=
LASTRO_ADMIN_HOST=127.0.0.1
LASTRO_ADMIN_PORTA=8081
# Provedor OIDC (SSO). O curador é cadastrado por (emissor, sub): pnpm lastro curador criar
LASTRO_ADMIN_OIDC_EMISSOR=
LASTRO_ADMIN_OIDC_CLIENTE_ID=
LASTRO_ADMIN_OIDC_CLIENTE_SEGREDO=
# Valores de amr aceitos como segundo fator (RFC 8176); padrão hwk = chave física/WebAuthn, resistente a phishing
LASTRO_ADMIN_OIDC_AMR=hwk
# Duração máxima da sessão do curador, em minutos (5 a 720)
LASTRO_ADMIN_SESSAO_MIN=120

# Divulgação de vulnerabilidades (Fase 4): /.well-known/security.txt na API e no portal (RFC 9116).
# Vazio = sem arquivo. Expira obrigatório (no máximo um ano à frente); arquivo vencido deixa de ser servido.
LASTRO_SECURITY_CONTATO=
LASTRO_SECURITY_EXPIRA=
LASTRO_SECURITY_POLITICA=

# Portal público (Fase 4, `pnpm portal`). Origem separada da API e do painel.
LASTRO_PORTAL_HOST=127.0.0.1
LASTRO_PORTAL_PORTA=8082
# Origem pública do portal (conferida no Origin de todo POST); obrigatória fora de 127.0.0.1
LASTRO_PORTAL_URL_PUBLICA=
# Cliente anônimo do portal: pnpm lastro cliente criar --nome "Portal público" --plano portal-publico
LASTRO_PORTAL_CLIENTE_ID=
# turnstile | hcaptcha | desligado (desligado só com o portal em 127.0.0.1)
LASTRO_PORTAL_CAPTCHA=desligado
LASTRO_PORTAL_CAPTCHA_SITE=
LASTRO_PORTAL_CAPTCHA_SEGREDO=
# Perguntas e verificações por IP por hora
LASTRO_PORTAL_LIMITE_HORA_IP=10
# IPs ou faixas CIDR do proxy reverso (TLS) cujo X-Forwarded-For é confiável, separados por vírgula
LASTRO_PORTAL_PROXY=

# Canais (Fase 4, `pnpm canais`): comando /lastro do Slack em <origem>/slack/comandos.
LASTRO_CANAIS_HOST=127.0.0.1
LASTRO_CANAIS_PORTA=8083
# Signing Secret do app do Slack. Vincule cada workspace: pnpm lastro slack vincular --team T… --cliente <uuid>
LASTRO_SLACK_SEGREDO_ASSINATURA=
